# Bu dosyayı ".env" adıyla kopyala ve değerleri düzenle.

# Sunucunun dinleyeceği port (cPanel/Passenger bunu kendisi ayarlar, boş bırakabilirsin)
PORT=3000

# Veritabanı ve yüklenen dosyaların saklanacağı klasör (varsayılan: ./data)
# DATA_DIR=/home/kullanici/biscord-data

# Maksimum dosya yükleme boyutu (MB)
MAX_UPLOAD_MB=25

# TURN sunucusu (farklı ağlardaki kullanıcıların sesli konuşabilmesi için önerilir)
# TURN_URL=turn:turn.siten.com:3478
# TURN_USER=biscord
# TURN_PASS=gizli-sifre

# Örnek bot için
# BISCORD_URL=https://siten.com
# BOT_TOKEN=
# BOT_PREFIX=!
