# Bu dosyayı ".env" adıyla kopyala ve değerleri düzenle.
# GoDaddy Node.js Hosting'de bu değerleri panelin "Ortam Değişkenleri" bölümüne gir.

# Sunucunun dinleyeceği port (barındırma bunu kendisi verir, boş bırak)
# PORT=3000

# Veritabanı ve yüklenen dosyaların saklanacağı klasör (varsayılan: ./data)
# DATA_DIR=/kalici/klasor

# Maksimum dosya yükleme boyutu (MB)
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- yönetici
# Yönetici hesabının adı (görünen ad olarak aynen, kullanıcı adı olarak küçük harfle kullanılır).
# ŞİFREYİ ASLA GitHub'a yazma — yalnızca .env dosyasına veya GoDaddy ortam değişkenine gir.
# ADMIN_PASSWORD verilmezse geçici "admin" şifresi oluşur ve ilk girişte değiştirmek zorunludur.
ADMIN_USERNAME=Adminolmakben
# ADMIN_PASSWORD=buraya-sifreni-yaz

# ---------------------------------------------------------------- e-posta: Brevo (önerilen)
# Ayrıntılar: BREVO-KURULUM.md
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Biscord <bildirim@alanadin.com>

# ---------------------------------------------------------------- e-posta: SMTP (alternatif)
# Şifre sıfırlama, e-posta doğrulama ve e-postayla giriş kodu için gerekir.
# Gmail örneği (Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=senin.adresin@gmail.com
# SMTP_PASS=16-haneli-uygulama-sifresi
# SMTP_FROM=Biscord <senin.adresin@gmail.com>

# ---------------------------------------------------------------- anlık bildirimler (isteğe bağlı)
# Boş bırakırsan anahtarlar otomatik üretilip veritabanına kaydedilir.
# Veriler kalıcı değilse (her güncellemede siliniyorsa) sabit anahtar ver:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:sen@alanadin.com

# ---------------------------------------------------------------- sesli konuşma (TURN)
# TURN_URL=turn:turn.siten.com:3478
# TURN_USER=biscord
# TURN_PASS=gizli-sifre

# ---------------------------------------------------------------- örnek bot
# BISCORD_URL=https://siten.com
# BOT_TOKEN=
# BOT_PREFIX=!
